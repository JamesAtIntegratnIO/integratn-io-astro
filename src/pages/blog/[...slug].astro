---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { publishedPosts, titleCase } from "../../posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"posts"> };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, series, tags = [], card } = post.data;
// The byline reads a date the way a person writes one, and how long the post takes.
const longDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const minutes = Math.max(1, Math.round((post.body ?? "").split(/\s+/).filter(Boolean).length / 230));
---

<Base title={title} description={description} nav="blog" image={card} article={{ published: pubDate, modified: updatedDate, tags }}>
  <div class="article">
    <div class="page-head">
      <p class="trail"><a href="/">Integratn</a> / <a href="/blog/">Blog</a> / {pubDate.getUTCFullYear()}</p>
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{longDate(pubDate)}</time>
      <span> · {minutes} min read</span>
      {updatedDate && <span> · Updated <time datetime={updatedDate.toISOString()}>{longDate(updatedDate)}</time></span>}
      {series && <span> · Part of <a href={`/blog/series/${series}/`}>{titleCase(series)}</a></span>}
    </p>
    <article class="doc" data-read-depth><Content /></article>
    {tags.length > 0 && (
      <nav class="post-tags" aria-label="Tags">
        {tags.map((tag) => <a class="chip" href={`/blog/tags/${tag}/`}>#{tag}</a>)}
      </nav>
    )}
  </div>
</Base>
