---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { publishedPosts } from "../../posts";

const posts = await publishedPosts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
---

<Base title="Blog" nav="blog">
  <div class="page-head">
    <p class="trail"><a href="/">Integratn</a> / Blog</p>
    <h1>Blog</h1>
    <p>
      Notes from building and running infrastructure: Kubernetes, GitOps, netboot, and a seven-part Docker
      course. Browse by <a href="/blog/tags/">tag</a>, <a href="/blog/series/">series</a> or
      <a href="/blog/categories/">category</a>.
    </p>
  </div>
  {years.map((year) => (
    <section class="year">
      <h2>{year}</h2>
      <PostList posts={posts.filter((post) => post.data.pubDate.getUTCFullYear() === year)} />
    </section>
  ))}
</Base>
