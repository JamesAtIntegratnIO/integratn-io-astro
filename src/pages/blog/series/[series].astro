---
import type { CollectionEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import { groupBy, publishedPosts, titleCase } from "../../../posts";

export async function getStaticPaths() {
  const groups = groupBy(await publishedPosts(), "series");
  return [...groups].map(([series, posts]) => ({ params: { series }, props: { posts } }));
}

const { series } = Astro.params;
const { posts } = Astro.props as { posts: CollectionEntry<"posts">[] };
// A series reads in order: by the part number in the titles when every post
// carries one ("Docker Training 3"), otherwise oldest first.
const part = (post: CollectionEntry<"posts">) => Number(post.data.title.match(/\d+/)?.[0] ?? NaN);
const ordered = posts.every((post) => !Number.isNaN(part(post)))
  ? [...posts].sort((a, b) => part(a) - part(b))
  : [...posts].reverse();
---

<Base title={titleCase(series!)} nav="blog">
  <div class="page-head">
    <p class="trail"><a href="/">Integratn</a> / <a href="/blog/">Blog</a> / <a href="/blog/series/">Series</a></p>
    <h1>{titleCase(series!)}</h1>
  </div>
  <section class="band"><PostList posts={ordered} /></section>
</Base>
