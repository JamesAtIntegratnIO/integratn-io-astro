---
import Base from "../../../layouts/Base.astro";
import { groupBy, publishedPosts, titleCase } from "../../../posts";

const groups = groupBy(await publishedPosts(), "series");
---

<Base title="Series" nav="blog">
  <div class="page-head"><p class="trail"><a href="/">Integratn</a> / <a href="/blog/">Blog</a> / Series</p><h1>Series</h1></div>
  <ul class="terms">
    {[...groups].map(([name, posts]) => (
      <li><a class="chip" href={`/blog/series/${name}/`}>{titleCase(name)} · {posts.length}</a></li>
    ))}
  </ul>
</Base>
